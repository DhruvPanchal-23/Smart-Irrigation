# ==========================================
# SMART IRRIGATION SYSTEM - GITIGNORE
# ==========================================

# 1. DOCUMENTATION
# ==========================================
docs/
*.md
**/*.md

# 2. AI AGENT FILES
# ==========================================
.agents/
AGENTS.md

# 3. GIT AND EDITOR CONFIGURATION
# ==========================================
.gitattributes
.editorconfig
.prettierignore
.prettierrc
.prettierrc.json

# 4. DOCKER
# ==========================================
docker-compose.yml
docker-compose.yaml
docker-compose.override.yml

# 5. DEPENDENCIES
# ==========================================
node_modules/
**/node_modules/

# 6. ENVIRONMENT VARIABLES AND SECRETS
# ==========================================
.env
.env.*
**/.env
**/.env.*

*.pem
*.key
*.p12
*.pfx
secrets/
credentials.json
service-account*.json

# 7. FRONTEND AND BACKEND BUILD OUTPUTS
# ==========================================
dist/
build/
out/
.next/
.vite/
.cache/

# 8. LOG FILES
# ==========================================
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 9. TEST OUTPUTS AND COVERAGE
# ==========================================
coverage/
.nyc_output/
test-results/
playwright-report/

# 10. DEPLOYMENT GENERATED FILES
# ==========================================
.vercel/
.netlify/

# 11. EDITOR AND OPERATING SYSTEM FILES
# ==========================================
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo

# 12. TEMPORARY FILES
# ==========================================
*.tmp
*.temp
tmp/
temp/

